{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "NotebookEdit",
      "mcp__context7",
      "mcp__context7__*",
      "mcp__codex",
      "mcp__codex__*",
      "mcp__playwright",
      "mcp__playwright__*",
      "mcp__scheduled-tasks",
      "mcp__scheduled-tasks__*",
      "mcp__mcp-registry",
      "mcp__mcp-registry__*",
      "mcp__ccd_directory",
      "mcp__ccd_directory__*",
      "mcp__ccd_session",
      "mcp__ccd_session__*",
      "mcp__ccd_session_mgmt",
      "mcp__ccd_session_mgmt__*",
      "mcp__Claude_Preview",
      "mcp__Claude_Preview__*",
      "mcp__Claude_in_Chrome",
      "mcp__Claude_in_Chrome__*",
      "mcp__061a993d-7b72-449c-882f-88987af82973",
      "mcp__061a993d-7b72-449c-882f-88987af82973__*",
      "mcp__linear__save_comment",
      "mcp__linear__save_issue",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git show *)",
      "Bash(git remote *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(uv *)",
      "Bash(node *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(make *)",
      "Bash(python3 *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(mv *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm -rf *)",
      "Bash(mkfs *)",
      "Bash(dd if=*)",
      "Bash(git reset --hard *)",
      "Bash(git commit --amend)",
      "Bash(git commit --amend *)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push -*f)",
      "Bash(git push -*f* *)",
      "Bash(git push --mirror*)",
      "Bash(git push * +*)",
      "Bash(git rebase -i *)",
      "Bash(git clean -f*)"
    ],
    "ask": [
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/TempoTerm.app/Contents/MacOS/tempo-term\" --status-hook claude notification"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/auto_approve_safe.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/TempoTerm.app/Contents/MacOS/tempo-term\" --status-hook claude waiting-approval"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/TempoTerm.app/Contents/MacOS/tempo-term\" --status-hook claude active"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_compact.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_bash_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_write_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/workflow_route_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/TempoTerm.app/Contents/MacOS/tempo-term\" --status-hook claude active"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/TempoTerm.app/Contents/MacOS/tempo-term\" --status-hook claude end"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/awake-gate.sh release",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/TempoTerm.app/Contents/MacOS/tempo-term\" --status-hook claude idle"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code finished\" with title \"Claude Code\" sound name \"Glass\"' 2>/dev/null; L=~/.claude/logs/auto_approve.log; if [ -f $L ] && [ $(stat -f%z $L) -gt 5242880 ]; then tail -n 2000 $L > $L.tmp && mv $L.tmp $L; fi; true"
          },
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/verify_gate.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/TempoTerm.app/Contents/MacOS/tempo-term\" --status-hook claude idle"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/awake-gate.sh release",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/awake-gate.sh release",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/codex-reconcile-phantoms.sh --hook",
            "timeout": 8,
            "statusMessage": "Reconciling stale Codex jobs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/TempoTerm.app/Contents/MacOS/tempo-term\" --status-hook claude thinking"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/awake-gate.sh acquire",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/po-chi/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/po-chi/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "code-review@claude-plugins-official": false,
    "codex@openai-codex": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "*"
      ]
    }
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true
}
