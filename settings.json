{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "NotebookEdit",
      "mcp__context7",
      "mcp__context7__*",
      "mcp__playwright",
      "mcp__playwright__*",
      "mcp__scheduled-tasks",
      "mcp__scheduled-tasks__*",
      "mcp__mcp-registry",
      "mcp__mcp-registry__*",
      "mcp__ccd_directory",
      "mcp__ccd_directory__*",
      "mcp__ccd_session",
      "mcp__ccd_session__*",
      "mcp__ccd_session_mgmt",
      "mcp__ccd_session_mgmt__*",
      "mcp__Claude_Preview",
      "mcp__Claude_Preview__*",
      "mcp__Claude_in_Chrome",
      "mcp__Claude_in_Chrome__*",
      "mcp__061a993d-7b72-449c-882f-88987af82973",
      "mcp__061a993d-7b72-449c-882f-88987af82973__*",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git show *)",
      "Bash(git remote *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(uv *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(gh *)",
      "Bash(orca linear *)",
      "Bash(orca status *)",
      "Bash(orca skills get *)",
      "Bash(curl *)",
      "Bash(make *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(mv *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf *)",
      "Bash(mkfs *)",
      "Bash(dd if=*)",
      "Bash(git commit --amend)",
      "Bash(git commit --amend *)",
      "Bash(git rebase -i *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "humanizer": "off",
    "vercel-composition-patterns": "off",
    "writing-guidelines": "off",
    "orchestration": "off",
    "community-marketing": "off",
    "copy-editing": "off",
    "audit-pr-topics": "off",
    "strategy-review": "off",
    "asd-ste100": "off",
    "stop-slop": "off",
    "vercel-react-best-practices": "off",
    "web-design-guidelines": "off"
  },
  "deniedMcpServers": [
    {
      "serverUrl": "https://mcp.supabase.com/*"
    },
    {
      "serverName": "claude.ai Supabase"
    },
    {
      "serverUrl": "https://mcp.posthog.com/*"
    },
    {
      "serverName": "posthog"
    }
  ],
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/auto_approve_safe.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_bash_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_write_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/workflow_route_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/awake-gate.sh release",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "(python3 \"$HOME/.agents/skills/session-insights/scripts/insights.py\" ingest >/dev/null 2>&1 &)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code finished\" with title \"Claude Code\" sound name \"Glass\"' 2>/dev/null; L=~/.claude/logs/auto_approve.log; if [ -f $L ] && [ $(stat -f%z $L) -gt 5242880 ]; then tail -n 2000 $L > $L.tmp && mv $L.tmp $L; fi; true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/awake-gate.sh release",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/skills/endgame/scripts/stop_gate.py\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/awake-gate.sh release",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/awake-gate.sh acquire",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": false,
    "code-review@claude-plugins-official": false,
    "codex@openai-codex": true,
    "diagram-design@diagram-design": false,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      },
      "autoUpdate": true
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "*"
      ]
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 400000,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": false
}
