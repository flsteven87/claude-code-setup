#!/usr/bin/env bash
# codex-hygiene — blunt recovery when the Codex plugin is wedged.
#
# ⚠️ THIS IS NOT SELECTIVE. It pkills every matching Codex process and deletes
# EVERY per-job state file, with no liveness or staleness check. A healthy job
# running in another Claude Code window dies with the rest, and its state is
# gone rather than marked failed. Run it only when Codex is already unusable and
# you accept losing whatever is in flight.
#
# For the routine case — a job stuck on "running" because its process died —
# use codex-reconcile-phantoms.sh instead. That one probes liveness, only
# touches jobs whose pid is dead, marks them failed instead of deleting, and is
# safe while other windows are live.
#
# The symptom this exists for, observed locally: the companion exits 0 while the
# app-server survives orphaned, leaving the state file stuck on "running".
# openai/codex-plugin-cc#277 is the nearest upstream report and is still open,
# though its title describes a Windows review-hang rather than this orphan case —
# treat the link as related, not as a diagnosis.
#
# Scope on macOS: the patterns match the codex CLI and companion only; the
# unrelated "Codex Computer Use" desktop app (SkyComputerUseClient) is untouched.

set -u

pkill -f 'codex-companion' 2>/dev/null || true
pkill -f 'codex/dist'      2>/dev/null || true
pkill -f 'codex .* app-server' 2>/dev/null || true

state_root="$HOME/.claude/plugins/data"
deleted=0
if [ -d "$state_root" ]; then
  deleted=$(find "$state_root" -path '*/codex*/state/*/jobs/*' -type f 2>/dev/null | wc -l | tr -d ' ')
  find "$state_root" -path '*/codex*/state/*/jobs/*' -type f -delete 2>/dev/null || true
fi

echo "codex-hygiene: Codex processes killed, deleted ${deleted} job state file(s) (all of them, live or not)"
