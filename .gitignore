# Credentials & secrets
.credentials.json
mcp-needs-auth-cache.json
secrets/

# Discord (contains personal channel IDs and bot tokens)
channels/

# Session & runtime state
projects/
debug/
logs/
transcripts/
sessions/
shell-snapshots/
state/
tasks/
todos/
plans/
teams/
telemetry/
statsig/
usage-data/
file-history/
history.jsonl
paste-cache/
session-env/

# Cache
stats-cache.json
*-cache.json
cache/
image-cache/

# Backups & snapshots
backups/
*.backup-*
*.backup
skills.archive-*/
skills.deleted-*/

# Plugins (auto-generated by Claude Code on install, contains machine-specific paths)
plugins/

# Chrome extension binary
chrome/

# Hooks runtime artifacts
hooks/*.log
hooks/__pycache__/

# Root-level runtime logs (incl. dippy hook-approvals.log — path hardcoded in dippy)
*.log

# Python bytecode
__pycache__/
*.pyc
**/__pycache__/
**/*.pyc

# OS files
.DS_Store
commands.bak-*/

# Auto-generated update timestamp
.last-cleanup
.last-update-result.json

# Machine/account-managed state (Claude Code internal, not user config)
policy-limits.json

# Backup files (incl. settings.json.bak, written by the Orca app on install)
*.bak-*
*.bak

# Awake-gate lock tokens (one file per live session, meaningless off this machine)
run/

# Automation run artifacts — regenerable output, not config.
# PROMPT.md, run.sh and memory.md ARE tracked; only the per-run products are not.
automations/*/results/
automations/*/logs/
automations/*/.run.lock/

# Skills owned by the Orca / skills CLI install at ~/.agents/skills.
# These are symlinks: committing them stores a path that dangles on any other machine.
# setup.sh checks that the link targets exist.
skills/catchup
skills/computer-use
skills/graph-decide
skills/graph-deliver
skills/graph-dispatch
skills/graph-integrate
skills/graph-portfolio
skills/graph-refresh
skills/graph-run
skills/graph-ticket
skills/handoff
skills/orca-cli
skills/orca-emulator
skills/orca-linear
skills/orchestration

# Skills installed from vercel-labs/agent-skills by the skills CLI. Vendoring
# another project's content into a public repository is redistribution.
skills/vercel-composition-patterns/
skills/vercel-react-best-practices/
skills/web-design-guidelines/
skills/writing-guidelines/
